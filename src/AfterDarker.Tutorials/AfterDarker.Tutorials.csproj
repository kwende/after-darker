<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>
    <UnicornNativePath>$(RepositoryRoot)artifacts\unicorn\2.1.3\win-x64\unicorn.dll</UnicornNativePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnicornEngine.Unicorn" Version="2.1.3" />
    <None Include="$(UnicornNativePath)" Link="unicorn.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The NuGet package omits Windows native binaries. Restore the matching release. -->
  <Target Name="RestoreNativeUnicorn" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)tools\restore-unicorn.ps1&quot;" />
  </Target>

  <!-- Unicorn's longjmp path is incompatible with CFG. Only modify our generated apphost. -->
  <Target Name="ConfigureTutorialAppHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)tools\configure-tutorial-apphost.ps1&quot; -ExecutablePath &quot;$(TargetDir)$(AssemblyName).exe&quot;" />
  </Target>
</Project>
