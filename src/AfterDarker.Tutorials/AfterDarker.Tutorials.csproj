<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Inspection/Win16OrdinalNames.tsv" />
    <ProjectReference Include="../AfterDarker.Core/AfterDarker.Core.csproj" />
    <ProjectReference Include="../AfterDarker.Runtime/AfterDarker.Runtime.csproj" />
    <PackageReference Include="UnicornEngine.Unicorn" Version="2.1.3" />
  </ItemGroup>

  <!-- Unicorn's longjmp path is incompatible with CFG. Only modify our generated apphost. -->
  <Target Name="ConfigureTutorialAppHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)tools\configure-tutorial-apphost.ps1&quot; -ExecutablePath &quot;$(TargetDir)$(AssemblyName).exe&quot;" />
  </Target>
</Project>
