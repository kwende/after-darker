<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\</RepositoryRoot>
    <UnicornNativePath>$(RepositoryRoot)artifacts\unicorn\2.1.3\win-x64\unicorn.dll</UnicornNativePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AfterDarker.Core/AfterDarker.Core.csproj" />
    <PackageReference Include="UnicornEngine.Unicorn" Version="2.1.3" />
    <None Include="$(UnicornNativePath)" Link="unicorn.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The existing pinned engine now belongs to the reusable execution layer.
       The native asset propagates to hosts; apphost CFG configuration stays with each executable. -->
  <Target Name="RestoreNativeUnicorn" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepositoryRoot)tools\restore-unicorn.ps1&quot;" />
  </Target>
</Project>
