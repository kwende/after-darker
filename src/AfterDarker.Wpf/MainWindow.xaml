<Window x:Class="AfterDarker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="After Darker" Width="960" Height="780"
        MinWidth="660" MinHeight="520" Background="#15171B" Foreground="#E6E9EF"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <DockPanel x:Name="Root">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="LoadMenu" Header="_Load AD file…" Click="Browse_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="ModuleTitle" Text="AFTER DARKER" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Original Win16 code. A modern window." Foreground="#A9B2C2" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModulePath" VerticalContentAlignment="Center" Padding="8" ToolTip="Path to a supported local AD module"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Padding="12,6" Margin="8,0,0,0" Click="Browse_Click"/>
            <ComboBox x:Name="Speed" Grid.Column="2" Width="100" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Original module speed; applies on Run"/>
            <Button x:Name="RunButton" Grid.Column="3" Content="Run" Padding="18,6" Margin="8,0,0,0" Click="Run_Click"/>
            <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Padding="18,6" Margin="8,0,0,0" IsEnabled="False" Click="Stop_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="Black" BorderBrush="#39404C" BorderThickness="1">
            <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>
        <TextBlock x:Name="Status" Grid.Row="3" Text="File → Load AD file… to play Mondrian, Spiral Gyra or Rainstorm." TextWrapping="Wrap"
                   Margin="0,14,0,0" Foreground="#BFC9D8" FontSize="13"/>
    </Grid>
    </DockPanel>
</Window>
